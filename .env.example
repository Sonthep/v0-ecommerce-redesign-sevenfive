# ─── Application ───────────────────────────────────────────────────────
# Base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site name shown in metadata
NEXT_PUBLIC_SITE_NAME=SevenFive

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sevenfive

# ─── Auth ──────────────────────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-min-32-chars
AUTH_URL=http://localhost:3000/api/auth

# ─── Search (e.g. Algolia / Meilisearch) ───────────────────────────────
NEXT_PUBLIC_SEARCH_APP_ID=your-app-id
SEARCH_API_KEY=your-admin-api-key
NEXT_PUBLIC_SEARCH_INDEX=products

# ─── File storage (e.g. Cloudflare R2 / S3) ───────────────────────────
STORAGE_BUCKET=sevenfive-assets
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# ─── Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Email (e.g. Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@sevenfive.co.th
